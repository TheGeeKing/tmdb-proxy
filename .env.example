# Required: paste your private TMDB API Read Access Token here; no Bearer prefix.
TMDB_READ_ACCESS_TOKEN=
# External Docker port; leave empty to use 8080.
PORT=
# Optional production image override (exact version or digest supported).
# RELAY_IMAGE=ghcr.io/thegeeking/tmdb-proxy:1
# Bundled Valkey service. Set a different URL here to use an external cache.
# redis://username:password@host:6379/0 or rediss://username:password@host:6380/0
# Percent-encode special characters in credentials. rediss verifies the server certificate.
VALKEY_URL=redis://valkey:6379/0
TMDB_API_VERSIONS=3,4
CACHE_TTL_DETAILS_SECONDS=86400
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_LISTS_SECONDS=900
CACHE_TTL_TRENDING_SECONDS=300
CACHE_TTL_REFERENCE_SECONDS=604800
TMDB_TIMEOUT_SECONDS=15
# Shared across routes within one process; divide this budget across replicas.
TMDB_REQUESTS_PER_SECOND=40
TMDB_QUEUE_SIZE=200
VALKEY_TIMEOUT_SECONDS=2
MAX_RESPONSE_BYTES=10485760
# Empty disables CORS. Use exact origins separated by commas, or * (no credentials).
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
